Cell[CellGroupData[{

Cell["Sparse reconstruction demonstrator", "Section",ExpressionUUID->"3836f3ff-52c5-2341-893b-cdd630142ee6"],

Cell["\<\
SparseReconstruction[experiment, fraction, noise] is a demonstrator, not the \
paper's trained GCN. It samples a fraction of vertices (SeedRandom[42]), adds \
optional Gaussian noise in synthetic LAT units, fixes the measured values, \
and solves the Kirchhoff Laplacian on the unknown vertices so the estimate is \
harmonic on the unobserved set. It returns <|Estimate, Truth, \
MeasuredIndices, MeasuredValues, MAE, Fraction, Noise, Method|>.\
\>", "Text",ExpressionUUID->"36244f39-a89b-bf4c-a1e7-76c3f32bf28a"],

Cell[CellGroupData[{

Cell["\<\
reconstruction = SparseReconstruction[experiment, .25, .25]; \
KeyTake[reconstruction, {\"MAE\", \"Fraction\", \"Noise\", \"Method\"}]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"87e0b49d-c36d-a643-ac7f-6933f120ccb5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MAE\"\>", "\[Rule]", "0.43308944887680734`"}], ",", 
   RowBox[{"\<\"Fraction\"\>", "\[Rule]", "0.25`"}], ",", 
   RowBox[{"\<\"Noise\"\>", "\[Rule]", "0.25`"}], ",", 
   RowBox[{"\<\"Method\"\>", 
    "\[Rule]", "\<\"Harmonic graph interpolation demonstrator; not trained \
HeartGCN\"\>"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.99343963522406*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"511ea617-24a6-b745-bbd2-a4df7e5e706c"]
}, Open  ]],

Cell["\<\
Interactive sweep over sampling fraction and noise showing how the \
demonstrator MAE changes. This is a qualitative sensitivity demonstration of \
claim C9 (error decreases as sampling increases), not a confidence interval.\
\>", "Text",ExpressionUUID->"d7030589-98ee-f746-80c8-9272b6471900"],

Cell[CellGroupData[{

Cell["\<\
Manipulate[Module[{r}, SeedRandom[42]; r = SparseReconstruction[experiment, \
fraction, noise]; ListDensityPlot[MapThread[Append, {experiment[\"Coordinates\
\"], r[\"Estimate\"]}], InterpolationOrder -> 0, PlotLabel -> \
Row[{\"Demonstrator MAE: \", NumberForm[r[\"MAE\"], 3]}]]], {fraction, .1, 1, \
.05}, {noise, 0, 1, .05}]\
\>", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"5e22afa6-e780-ab48-8a05-55cd8233ca33"],

