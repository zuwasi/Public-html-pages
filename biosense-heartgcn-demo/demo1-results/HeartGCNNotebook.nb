Cell["\<\
The package verifies aggregation, update, weighted LAT/QRS loss, anisotropic \
edge metric, travel time, and shortest-path propagation. Clinical \
reproduction is blocked by absent meshes, data, preprocessing constants, \
source code, and weights.\
\>", "Text",ExpressionUUID->"e9250587-8abf-794d-b367-2838763f3381"]
}, Open  ]]
}, Open  ]]
