projectDir = DirectoryName[$InputFileName]; SetDirectory[projectDir]; If[!DirectoryQ["exports"], CreateDirectory["exports"]];
Get[FileNameJoin[{projectDir,"src","HeartGCNModel.wl"}]]; validation = HeartGCNModel`RunValidationSuite[];
validationJSON = "{\"Seed\":42,\"Passed\":" <> ToString[validation["Passed"]] <> ",\"Failed\":" <> ToString[validation["Failed"]] <> ",\"Total\":" <> ToString[validation["Total"]] <> "}";
Export["exports/validation_results.json", validationJSON, "Text"];
exp = HeartGCNModel`SyntheticWavefront[]; sweep = Flatten[Table[With[{r=HeartGCNModel`SparseReconstruction[exp,f,n]}, {f,n,r["MAE"]}], {f,{.1,.25,.5,.75,1.}}, {n,{0.,.25,1.}}],1];
Export["exports/reference_vectors.csv", Prepend[MapIndexed[{First[#2],Sequence@@#1}&, Transpose[{exp["Coordinates"],exp["Truth"]}]], {"vertex","coordinate","truth"}]];
Export["exports/boundary_vectors.csv", {{"case","input","result"},{"zero speed","l=1,c=0","Infinity"},{"fiber aligned","e=(2,0,0)",2},{"transverse","e=(0,3,0)",Sqrt[3]},{"empty neighborhood","dimension=2","{0,0}"}}];
manifest=<|"Phase"->2,"CppImplemented"->False,"Purpose"->"Future C++ interoperability contracts only","Contracts"->{<|"Function"->"WeightedLATMSE","Inputs"->{"prediction[]","truth[]","measuredMask[]"},"Tolerance"->10^-12|>,<|"Function"->"VirtualEdgeLength","Inputs"->{"edge[]","unitFiber[]","r"},"Tolerance"->10^-12|>,<|"Function"->"EdgeTravelTime","Inputs"->{"length","positiveSpeed"},"Tolerance"->10^-12|>}|>;
Export["exports/differential_test_manifest.json",manifest,"JSON"];
coords=exp["Coordinates"]; g=exp["Graph"]; truth=exp["Truth"]; rec=HeartGCNModel`SparseReconstruction[exp,.25,.25];
Export["exports/sparse_wavefront.png", Graph[g,VertexCoordinates->coords,VertexStyle->Thread[Range[Length[truth]]->(ColorData["TemperatureMap"]/@Rescale[truth])],ImageSize->700],"PNG"];
Export["exports/reconstruction.png", ListDensityPlot[MapThread[Append,{coords,rec["Estimate"]}],InterpolationOrder->0,PlotLegends->Automatic,FrameLabel->{"x","y"},PlotLabel->"Harmonic reconstruction demonstrator (not trained GCN)",ImageSize->700],"PNG"];
Export["exports/error_sampling_noise.png", ListLinePlot[Table[Select[sweep,#[[2]]==n&][[All,{1,3}]],{n,{0.,.25,1.}}],PlotLegends->{"noise 0","noise 0.25","noise 1"},Frame->True,FrameLabel->{"sampling fraction","MAE"},ImageSize->700],"PNG"];
boundary={{0,HeartGCNModel`EdgeTravelTime[1,0]},{1/100,HeartGCNModel`EdgeTravelTime[1,1/100]},{1/10,HeartGCNModel`EdgeTravelTime[1,1/10]},{1,HeartGCNModel`EdgeTravelTime[1,1]}};
Export["exports/stability_boundary.png",ListLogLogPlot[Rest[boundary],Joined->True,Frame->True,FrameLabel->{"speed","travel time"},PlotLabel->"Boundary: travel time diverges as speed approaches zero",ImageSize->700],"PNG"];
auditProcess = RunProcess[{"C:\\Program Files\\Wolfram Research\\Wolfram\\14.3\\WolframKernel.exe","-script",FileNameJoin[{projectDir,"proof_audit.wls"}]}];
If[auditProcess["ExitCode"] =!= 0, Print[auditProcess["StandardError"]]; Exit[3]];
required={"validation_results.json","audit_report.txt","reference_vectors.csv","boundary_vectors.csv","differential_test_manifest.json","sparse_wavefront.png","reconstruction.png","error_sampling_noise.png","stability_boundary.png"};
If[!And@@((FileExistsQ["exports/"<>#]&&FileByteCount["exports/"<>#]>0)&/@required),Print["Missing/empty export"];Exit[2]]; Print["BUILD PASS: ",validation["Passed"],"/",validation["Total"]]; If[validation["Failed"]>0,Exit[1],Exit[0]];
